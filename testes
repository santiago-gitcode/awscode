# ==========================================
# DEFINIÇÃO DE CORES (ANSI)
# ==========================================
VERDE="\033[0;32m"
AMARELO="\033[1;33m"
VERMELHO="\033[0;31m"
AZUL="\033[0;36m"
RESET="\033[0m"

# ==========================================
# FUNÇÕES DE VALIDAÇÃO E ATUALIZAÇÃO DA AWS
# ==========================================

# Função para validar se o token atual da AWS está ativo e funcional
valida_token() {
    if aws sts get-caller-identity &> /dev/null; then
        return 0 # Sucesso
    else
        return 1 # Falha
    fi
}

# Função para criar/atualizar o arquivo de credenciais da AWS
atualiza_token() {
    if [ ! -z "$aws_access_key_id" ] && [ ! -z "$aws_secret_access_key" ] && [ ! -z "$aws_session_token" ]; then
        printf "${AZUL}Atualizando o Token da Sessão com as novas variáveis...${RESET}\n"
        
        mkdir -p ~/.aws
        echo "[default]" > ~/.aws/credentials
        echo "aws_access_key_id=$aws_access_key_id" >> ~/.aws/credentials
        echo "aws_secret_access_key=$aws_secret_access_key" >> ~/.aws/credentials
        echo "aws_session_token=$aws_session_token" >> ~/.aws/credentials
        
        # Validação final pós-atualização
        if valida_token; then
            printf "${VERDE}✔ Token atualizado e validado com sucesso!${RESET}\n"
            return 0
        else
            printf "${VERMELHO}❌ Erro: As novas variáveis coladas parecem inválidas ou expiradas.${RESET}\n"
            return 1
        fi
    else
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "⚠️  ATENÇÃO: Credenciais da AWS não encontradas!\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "Para resolver, siga estes passos simples:\n\n"
        printf "1. No topo da página do laboratório, clique no botão ${VERMELHO}[AWS Details]${RESET}.\n"
        printf "2. Copie as linhas das 3 variáveis de ambiente que vão aparecer.\n"
        printf "3. Cole-as diretamente aqui no Terminal e pressione ${VERMELHO}[Enter]${RESET}.\n"
        printf "4. Reexecute este script copiando e colando o comando abaixo:\n\n"
        printf "   ${VERDE}. <(wget -qO- https://codeinterno.git)${RESET}\n\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        return 1
    fi
}

# ==========================================
# FUNÇÃO DE LISTAGEM EC2 E ORIENTAÇÃO SSH
# ==========================================
listar_instancias_e_acesso() {
    printf "${AZUL}Buscando instâncias ativas na sua conta AWS...${RESET}\n\n"
    
    # 1. Verifica de forma segura se existe ALGUMA instância rodando (mesmo sem IP público)
    INSTANCIAS_ATIVAS=$(aws ec2 describe-instances --filters "Name=instance-state-name,Values=running" --query "Reservations[*].Instances[*].InstanceId" --output text 2>/dev/null)
    
    # Se a variável estiver vazia, não há instâncias rodando
    if [ -z "$INSTANCIAS_ATIVAS" ]; then
        printf "${VERMELHO}⚠️ \ Nenhuma instância EC2 criada ou em execução foi encontrada nesta conta.${RESET}\n\n"
        return 0 # Sai da função imediatamente
    fi

    # 2. Se chegou aqui, existem instâncias. Vamos buscar os IPs públicos.
    IP_LIST=$(aws ec2 describe-instances --filters "Name=instance-state-name,Values=running" --query "Reservations[*].Instances[*].PublicIpAddress" --output text 2>/dev/null)
    QTD_IPS=$(echo "$IP_LIST" | wc -w)

    # 3. Exibe a tabela formatada
    aws ec2 describe-instances --query "Reservations[*].Instances[*].{ \
        \"1_Name\":Tags[?Key=='Name']|[0].Value, \
        \"2_Tipo\":InstanceType, \
        \"3_Zone\":Placement.AvailabilityZone, \
        \"4_PublicIP\":PublicIpAddress}" \
    --filters "Name=instance-state-name,Values=running" \
    --output table

    # 4. Define qual será o valor do IP na string final com base na contagem
    if [ "$QTD_IPS" -eq 1 ]; then
        ALVO_SSH="$IP_LIST"
    else
        ALVO_SSH="IP_DO_SEU_SERVIDOR"
    fi

    # 5. Bloco informativo com instruções de acesso
    printf "\n"
    printf "${AMARELO}ATENÇÃO:${RESET} Se sua instância foi criada pelo script awscode do Prof. Santiago ela pode ser acessível pela\n"
    printf "chave privada (.pem): ${VERDE}https://tinyurl.com{RESET}\n"
    printf "\n"
    printf "Considere usar esse comando para copiar a chave para seu ambiente local:\n"
    printf "\n"
    printf "CMD (Prompt de Comandos): ${VERMELHO}curl -fsSLk -o chaveVM.pem https://tinyurl.com{RESET}\n"
    printf "\n"
    printf "Acessando a VM: ${VERMELHO}ssh -i chaveVM.pem admin@%s${RESET}\n" "$ALVO_SSH"
    printf "\n"
}


# ==========================================
# FLUXO PRINCIPAL DO SCRIPT
# ==========================================

# Verificando se está no ambiente LL Vocareum
if [ -d "/home/vocuser" ]; then
    # Se o token NÃO for válido, tenta atualizar
    if ! valida_token; then
        printf "${VERMELHO}Token atual expirado ou inexistente. Tentando atualizar...${RESET}\n"
        
        # Se falhar na atualização, interrompe o fluxo (já que a msg de erro está na função)
        if ! atualiza_token; then
            return 1
        fi
    fi
    
    # Se chegou até aqui, o token está válido (ou já estava, ou acabou de ser atualizado)
    listar_instancias_e_acesso

else
    printf "${AZUL}Estamos no AWS Console${RESET}\n"
    if valida_token; then
        listar_instancias_e_acesso 
    else
        printf "${VERMELHO}Erro: Sessão do AWS Console inválida ou expirada. Recarregue a página.${RESET}\n"
    fi
fi
