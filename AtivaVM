#!/bin/sh
# CALL: wget -qO- https://tinyurl.com/ativavm | sh

echo "Buscando instâncias EC2 na sua conta AWS..."

# Cria arquivos temporários para armazenar dados sem depender de arrays (que não existem no 'sh')
TMP_FILE=$(mktemp)
MAP_FILE=$(mktemp)

# Busca os dados e salva no arquivo temporário
aws ec2 describe-instances \
    --filters "Name=instance-state-name,Values=pending,running,shutting-down,stopping,stopped" \
    --query "Reservations[*].Instances[*].[InstanceId, State.Name, Tags[?Key=='Name'].Value | [0]]" \
    --output text > "$TMP_FILE"

# Verifica se o arquivo tem conteúdo
if [ ! -s "$TMP_FILE" ]; then
    echo "Nenhuma instância encontrada."
    rm -f "$TMP_FILE" "$MAP_FILE"
    exit 0
fi

echo ""
echo "------------------------------------------------------------------"
printf "%-5s | %-20s | %-12s | %-15s\n" "Item" "Instance ID" "Status" "Nome"
echo "------------------------------------------------------------------"

count=1
# Lê o arquivo temporário linha por linha. O read padrão lida muito bem com os espaços/tabs.
while read -r id state name; do
    if [ -z "$name" ] || [ "$name" = "None" ]; then
        name="<Sem Nome>"
    fi
    
    # Imprime na tela
    printf "%-5s | %-20s | %-12s | %-15s\n" "[$count]" "$id" "$state" "$name"
    
    # Salva um mapeamento do tipo "1 i-01234abcd" no segundo arquivo temporário
    echo "$count $id" >> "$MAP_FILE"
    
    count=$((count+1))
done < "$TMP_FILE"

echo "------------------------------------------------------------------"
echo ""

echo "Para economizar créditos do AWS Academy, vamos desligar o que não for usado."
echo "(DICA: Se você apenas apertar ENTER, TODAS as instâncias serão desligadas)"
# Usamos printf + read em vez de 'read -p', pois '-p' também não existe no 'sh' puro
printf "Quais instâncias devem FICAR LIGADAS? (ex: 1 3): "
read choices < /dev/tty

STOP_IDS=""

# Compara as escolhas do usuário com o arquivo de mapeamento
while read -r num id; do
    manter="nao"
    
    # Avalia os números digitados
    for choice in $choices; do
        if [ "$choice" = "$num" ]; then
            manter="sim"
            break
        fi
    done
    
    # Se não foi escolhida para manter, adicionamos à lista de parada (separada por espaço)
    if [ "$manter" = "nao" ]; then
        STOP_IDS="$STOP_IDS $id"
    fi
done < "$MAP_FILE"

# Limpa a casa apagando os arquivos temporários
rm -f "$TMP_FILE" "$MAP_FILE"

echo ""
if [ -n "$STOP_IDS" ]; then
    echo "Desligando as instâncias não selecionadas..."
    
    # A variável $STOP_IDS sem aspas aqui é proposital, ela passará os IDs separados
    aws ec2 stop-instances \
        --instance-ids $STOP_IDS \
        --query "StoppingInstances[*].{ID:InstanceId,Atual:CurrentState.Name,Anterior:PreviousState.Name}" \
        --output table
        
    echo "Feito! As instâncias foram desligadas com sucesso."
else
    echo "Todas as instâncias foram selecionadas para continuarem ligadas."
    echo "Nenhuma ação de desligamento foi realizada."
fi
