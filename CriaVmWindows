# ==========================================
# DEFINIÇÃO DE CORES (ANSI)
# ==========================================
VERDE="\033[0;32m"
AMARELO="\033[1;33m"
VERMELHO="\033[0;31m"
AZUL="\033[0;36m"
RESET="\033[0m"

# ==========================================
# BLOQUEIA A CHAMADA ANTIGA (| sh)
# ==========================================
if [ ! -t 0 ]; then
    printf "\n"
    printf "${VERMELHO} ATENÇÃO: A forma de executar este laboratório mudou!${RESET}\n\n"
    printf "Para que as credenciais da AWS funcionem corretamente no seu terminal, "
    printf "você não pode mais usar o comando terminando em '| sh'.\n\n"
    printf "${AZUL}Por favor, copie e cole o comando EXATO abaixo e pressione [Enter]:${RESET}\n\n"
    printf "   ${VERDE}. <(wget -qO- https://tinyurl.com/CriaVMWindows)${RESET}\n\n"
    
    exit 1 
fi

# ==========================================
# FUNÇÕES DE VALIDAÇÃO E ATUALIZAÇÃO DA AWS
# ==========================================
valida_token() {
    if aws ec2 describe-instances --max-items 1 > /dev/null 2>&1; then
        return 0 # Sucesso
    else
        return 1 # Falha
    fi
}

atualiza_token() {
    if [ ! -z "$aws_access_key_id" ] && [ ! -z "$aws_secret_access_key" ] && [ ! -z "$aws_session_token" ]; then
        printf "${AZUL}Atualizando o Token da Sessão com as novas variáveis...${RESET}\n"
        
        mkdir -p ~/.aws
        chmod 664 ~/.aws/credentials
        echo "[default]" > ~/.aws/credentials
        echo "aws_access_key_id=$aws_access_key_id" >> ~/.aws/credentials
        echo "aws_secret_access_key=$aws_secret_access_key" >> ~/.aws/credentials
        echo "aws_session_token=$aws_session_token" >> ~/.aws/credentials
        
        if valida_token; then
            printf "${VERDE}✔ Token atualizado e validado com sucesso!${RESET}\n"
            return 0
        else
            printf "${VERMELHO}❌ Erro: As novas variáveis coladas parecem inválidas ou expiradas.${RESET}\n"
            return 1
        fi
    else
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "⚠️  ATENÇÃO: Credenciais da AWS não encontradas!\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "Para resolver, siga estes passos simples:\n\n"
        printf "1. No topo da página do laboratório, clique no botão ${VERMELHO}[AWS Details]${RESET}.\n"
        printf "2. Copie as linhas das 3 variáveis de ambiente que vão aparecer.\n"
        printf "3. Cole-as diretamente aqui no Terminal e pressione ${VERMELHO}[Enter]${RESET}.\n"
        printf "4. Reexecute este script copiando e colando o comando abaixo:\n\n"
        printf "   ${VERDE}. <(wget -qO- https://tinyurl.com/CriaVMWindows)${RESET}\n\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        return 1
    fi
}

# ==========================================
# FUNÇÃO DE CRIAÇÃO DA EC2 (WINDOWS)
# ==========================================
criaVM(){
    # Tipo da Instancia (Tamanho)
    # INSTANCE_TIPO="m7i-flex.large"
    INSTANCE_TIPO="t3.medium"

    # Nome da Instância e Chave
    SERVER_NAME="ServerAD"
    KEY_NAME="chaveVM"

    KEY_PUB="chaveVM.pub"
    KEY_PUB_URL="https://tinyurl.com/chaveVMp"

    KEY_PRIV="chaveVM.pem"
    KEY_PRIV_URL="https://tinyurl.com/chaveVM"

    # 1. Verifica se a chave já existe
    existing_keys=$(aws ec2 describe-key-pairs --query "KeyPairs[?KeyName=='$KEY_NAME'].KeyName" --output text)

    if [ -z "$existing_keys" ]; then
        echo "Chave $KEY_NAME não encontrada. Importando..."
        wget --no-check-certificate -q -O $KEY_PUB $KEY_PUB_URL

        # Executa o comando de importação
        aws ec2 import-key-pair --key-name "$KEY_NAME" --public-key-material "fileb://$KEY_PUB"

        if [ $? -eq 0 ]; then
            echo "Chave $KEY_NAME importada com sucesso!"
            rm -f $KEY_PUB
        else
            echo "Erro ao importar a chave $KEY_NAME" >&2
            return 1 # Sai da função sem fechar o terminal
        fi
    fi

    # 2. Revisão das instâncias criadas (AGORA FORA DO ELSE)
    echo "Verificando instâncias existentes na conta..."
    instances=$(aws ec2 describe-instances \
        --filters "Name=instance-state-name,Values=pending,running,shutting-down,stopping,stopped" \
        --query "Reservations[*].Instances[*].[InstanceId,Tags[?Key=='Name'].Value | [0],InstanceType]" \
        --output text)

    if [ -n "$instances" ]; then
        echo ""
        echo "Instâncias encontradas:"
        while read -r ins_id ins_name ins_type; do
            [ -z "$ins_name" ] && ins_name="Sem Nome"

            echo "--------------------------------------------------"
            echo "Instância: $ins_name | Tipo: $ins_type | ID: $ins_id"
            read -p "Deseja remover esta instância antes de criar a nova? (y/n): " confirm < /dev/tty

            if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                echo "Removendo $ins_id ($ins_name)..."
                aws ec2 terminate-instances --instance-ids "$ins_id" > /dev/null
                echo "Comando de terminação enviado."
            else
                echo "Mantendo instância $ins_name."
            fi
        done <<< "$instances"
    else
        echo "Nenhuma instância ativa encontrada para revisão."
    fi
    echo "--------------------------------------------------"
    echo ""

    # 3. Preparação da Infraestrutura
    # Download da chave privada para recuperar a senha do Windows depois
    wget --no-check-certificate -q -O $KEY_PRIV $KEY_PRIV_URL

    VPC=$(aws ec2 describe-vpcs --filters "Name=isDefault,Values=true" --query "Vpcs[0].VpcId" --output text)

    aws ec2 create-security-group --group-name SG-ServerWindows --description "SG Servidor Windows" --vpc-id $VPC > /dev/null 2>&1
    SG_ID=$(aws ec2 describe-security-groups --filters "Name=group-name,Values=SG-ServerWindows" "Name=vpc-id,Values=$VPC" --query "SecurityGroups[0].GroupId" --output text)
    aws ec2 authorize-security-group-ingress --group-id $SG_ID --protocol tcp --port 0-65535 --cidr 0.0.0.0/0 > /dev/null 2>&1

    # 4. Obtendo a imagem mais recente da AWS para Windows 2022 - Core 
    echo "Buscando a AMI mais recente do Windows Server 2022..."
    AMI_ID=$(aws ec2 describe-images \
        --owners amazon \
        --filters "Name=name,Values=*Windows_Server-2022-English-Full-Base*" \
                  "Name=architecture,Values=x86_64" \
                  "Name=virtualization-type,Values=hvm" \
        --query 'Images | sort_by(@, &CreationDate)[-1].ImageId' \
        --output text)

    # 5. Lançar a instância e capturar o Instance ID 
    echo "Iniciando a criação do Servidor Windows..."
    instance_id=$(aws ec2 run-instances \
        --image-id $AMI_ID \
        --count 1 \
        --instance-type $INSTANCE_TIPO \
        --key-name $KEY_NAME \
        --security-group-ids $SG_ID \
        --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=\"$SERVER_NAME\"}]" \
        --query 'Instances[0].InstanceId' \
        --output text)

    echo "Máquina Windows 2022 Criada: Instance ID: $instance_id"

    # 6. Aguardar a instância estar no estado 'running'
    aws ec2 wait instance-running --instance-ids "$instance_id"

    # 7. Aguardar a senha ficar disponível
    echo "Aguardando por 2 minutos a senha ficar disponível..."
    sleep 120 

    # 8. Tentar obter a senha
    max_attempts=5
    attempt=1
    password_data=""

    while [[ $attempt -le $max_attempts && -z "$password_data" ]]; do
        password_data=$(aws ec2 get-password-data \
            --instance-id "$instance_id" \
            --priv-launch-key "$KEY_PRIV" \
            --query 'PasswordData' \
            --output text 2>/dev/null)

        if [ -z "$password_data" ]; then
            echo "Tentativa $attempt: Senha ainda não disponível..."
            echo "Aguardo mais 30 segundos..."
            sleep 30
            ((attempt++))
        fi
    done

    # 9. Exibir o resultado
    if [ -n "$password_data" ]; then
        public_ip=$(aws ec2 describe-instances \
            --instance-ids "$instance_id" \
            --query 'Reservations[0].Instances[0].PublicIpAddress' \
            --output text)
        echo "--------------------------------------------------"
        echo "Senha do Administrador: $password_data"
        echo "--------------------------------------------------"
        echo "IP: $public_ip"
    else
        echo "ERRO: Não foi possível obter a senha após $max_attempts tentativas"
        echo "Verifique manualmente com:"
        echo "aws ec2 get-password-data --instance-id $instance_id --priv-launch-key $KEY_PRIV"
    fi

    # Removendo o arquivo chave
    rm -f $KEY_PRIV
}

# ==========================================
# FLUXO PRINCIPAL DO SCRIPT
# ==========================================
if [ -d "/home/vocuser" ]; then
    if ! valida_token; then
        printf "${VERMELHO}Token atual expirado ou inexistente. Tentando atualizar...${RESET}\n"
        if ! atualiza_token; then
            return 1
        fi
    fi
    criaVM
else
    if valida_token; then
        criaVM 
    else
        printf "${VERMELHO}Erro: Sessão do AWS Console inválida ou expirada. Recarregue a página.${RESET}\n"
    fi
fi