#!/bin/sh
# CALL: wget -qO- https://tinyurl.com/CreateRota | sh

LOCAL_NETWORK_CIDR="192.168.10.0/24"

echo "Buscando instâncias rodando e suas interfaces de rede (ENIs)..."

# Arquivos temporários
TMP_FILE=$(mktemp)
MAP_FILE=$(mktemp)

# Busca os dados (ID da Instância, Nome, ID da ENI, ID da VPC) e salva no arquivo temporário
aws ec2 describe-instances \
    --filters "Name=instance-state-name,Values=running" \
    --query "Reservations[*].Instances[*].[InstanceId, Tags[?Key=='Name'].Value | [0], NetworkInterfaces[0].NetworkInterfaceId, VpcId]" \
    --output text > "$TMP_FILE"

# Verifica se o arquivo tem conteúdo (se há instâncias rodando)
if [ ! -s "$TMP_FILE" ]; then
    echo "Nenhuma instância em execução encontrada."
    rm -f "$TMP_FILE" "$MAP_FILE"
    exit 0
fi

echo ""
echo "--------------------------------------------------------------------------------"
printf "%-5s | %-20s | %-15s | %-20s\n" "Item" "Instance ID" "Nome" "ENI ID"
echo "--------------------------------------------------------------------------------"

count=1
# Lê o arquivo temporário
while read -r inst_id name eni_id vpc_id; do
    if [ -z "$name" ] || [ "$name" = "None" ]; then
        name="<Sem Nome>"
    fi
    
    # Imprime a linha na tela para o usuário
    printf "%-5s | %-20s | %-15s | %-20s\n" "[$count]" "$inst_id" "$name" "$eni_id"
    
    # Salva o mapeamento: Número escolhido, ENI_ID e VPC_ID
    echo "$count $eni_id $vpc_id" >> "$MAP_FILE"
    
    count=$((count+1))
done < "$TMP_FILE"

echo "--------------------------------------------------------------------------------"
echo ""

# Captura a entrada do usuário garantindo compatibilidade com execução via "curl | sh" ou "wget | sh"
printf "Escolha o número correspondente à ENI do roteador VPN (ex: 1): "
read choice < /dev/tty

SELECTED_ENI=""
SELECTED_VPC=""

# Lê o mapeamento para encontrar a ENI e a VPC escolhidas
while read -r num eni vpc; do
    if [ "$choice" = "$num" ]; then
        SELECTED_ENI="$eni"
        SELECTED_VPC="$vpc"
        break
    fi
done < "$MAP_FILE"

# Limpa os arquivos temporários
rm -f "$TMP_FILE" "$MAP_FILE"

# Verifica se o usuário digitou uma opção válida
if [ -z "$SELECTED_ENI" ]; then
    echo ""
    echo "Erro: Opção inválida. Operação cancelada."
    exit 1
fi

echo ""
echo "ENI selecionada: $SELECTED_ENI"
echo "VPC identificada: $SELECTED_VPC"

# Pega o ID da Tabela de Rotas Principal da VPC
ROUTE_TABLE_ID=$(aws ec2 describe-route-tables \
    --filters "Name=vpc-id,Values=$SELECTED_VPC" "Name=association.main,Values=true" \
    --query "RouteTables[0].RouteTableId" \
    --output text)

if [ "$ROUTE_TABLE_ID" = "None" ] || [ -z "$ROUTE_TABLE_ID" ]; then
    echo "Erro: Tabela de Rotas Principal não encontrada para a VPC $SELECTED_VPC."
    exit 1
fi

echo "Tabela de Rotas Principal: $ROUTE_TABLE_ID"
echo ""

# Cria a rota
echo "Criando rota para a rede local $LOCAL_NETWORK_CIDR apontando para $SELECTED_ENI..."
echo aws ec2 create-route \
    --route-table-id "$ROUTE_TABLE_ID" \
    --destination-cidr-block "$LOCAL_NETWORK_CIDR" \
    --network-interface-id "$SELECTED_ENI"

echo "Configuração concluída com sucesso!"

# Consulta e exibe as rotas atualizadas
echo ""
echo "--------------------------------------------------------------------------------------"
echo "Verificando as rotas atuais na Tabela $ROUTE_TABLE_ID:"
echo "--------------------------------------------------------------------------------------"

aws ec2 describe-route-tables \
    --route-table-ids "$ROUTE_TABLE_ID" \
    --query "RouteTables[0].Routes[*].{Destino:DestinationCidrBlock, Alvo_ENI:NetworkInterfaceId, Alvo_Gateway:GatewayId, Status:State}" \
    --output table

echo ""
