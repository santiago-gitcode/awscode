#!/bin/sh
# CALL: . <(wget -qO- https://tinyurl.com/s3rclone)
# CALL: https://tinyurl.com/s3rclone |sh  <-- Descontinuado

# ==========================================
# DEFINIÇÃO DE CORES (ANSI)
# ==========================================
VERDE="\033[0;32m"
AMARELO="\033[1;33m"
VERMELHO="\033[0;31m"
AZUL="\033[0;36m"
RESET="\033[0m"

# ==========================================
# BLOQUEIA A CHAMADA ANTIGA (| sh)
# ==========================================
# O teste [ ! -t 0 ] verifica se o File Descriptor 0 (stdin) NÃO é um terminal.
if [ ! -t 0 ]; then
    printf "\n"
    printf "${VERMELHO} ATENÇÃO: A forma de executar este laboratório mudou!${RESET}\n\n"
    printf "Para que as credenciais da AWS funcionem corretamente no seu terminal, "
    printf "você não pode mais usar o comando terminando em '| sh'.\n\n"
    printf "${AZUL}Por favor, copie e cole o comando EXATO abaixo e pressione [Enter]:${RESET}\n\n"
    printf "   ${VERDE}. <(wget -qO- https://tinyurl.com/s3rclone)${RESET}\n\n"
    
    # Aqui usamos exit 1 pois estamos em um subshell.
    exit 1 
fi

# ==========================================
# FUNÇÕES DE VALIDAÇÃO E ATUALIZAÇÃO DA AWS
# ==========================================

# Função para validar se o token atual da AWS está ativo e funcional
valida_token() {
    # if aws sts get-caller-identity > /dev/null 2>&1; then
    if aws ec2 describe-instances --max-items 1 > /dev/null 2>&1; then
        return 0 # Sucesso
    else
        return 1 # Falha
    fi
}

# Função para criar/atualizar o arquivo de credenciais da AWS
atualiza_token() {
    if [ ! -z "$aws_access_key_id" ] && [ ! -z "$aws_secret_access_key" ] && [ ! -z "$aws_session_token" ]; then
        printf "${AZUL}Atualizando o Token da Sessão com as novas variáveis...${RESET}\n"
        
        mkdir -p ~/.aws
        echo "[default]" > ~/.aws/credentials
        echo "aws_access_key_id=$aws_access_key_id" >> ~/.aws/credentials
        echo "aws_secret_access_key=$aws_secret_access_key" >> ~/.aws/credentials
        echo "aws_session_token=$aws_session_token" >> ~/.aws/credentials
        
        # Validação final pós-atualização
        if valida_token; then
            printf "${VERDE}✔ Token atualizado e validado com sucesso!${RESET}\n"
            return 0
        else
            printf "${VERMELHO}❌ Erro: As novas variáveis coladas parecem inválidas ou expiradas.${RESET}\n"
            return 1
        fi
    else
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "⚠️  ATENÇÃO: Credenciais da AWS não encontradas!\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "Para resolver, siga estes passos simples:\n\n"
        printf "1. No topo da página do laboratório, clique no botão ${VERMELHO}[AWS Details]${RESET}.\n"
        printf "2. Copie as linhas das 3 variáveis de ambiente que vão aparecer, aws_access_key_id, aws_secret_access_key e aws_session_token.\n"
        printf "3. Cole-as diretamente aqui no Terminal e pressione ${VERMELHO}[Enter]${RESET}.\n"
        printf "4. Reexecute este script copiando e colando o comando abaixo:\n\n"
        printf "   ${VERDE}. <(wget -qO- https://tinyurl.com/s3rclone)${RESET}\n\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        return 1
    fi
}

# ==========================================
# FUNÇÃO DE LISTAGEM EC2 E ORIENTAÇÃO SSH
# ==========================================

# Mapeamento de E-mails para Upstreams.
# Para adicionar novos usuários no futuro, basta copiar uma linha e alterar o e-mail/disco.
obter_upstream() {
    case "$1" in
        "fatec.2017sp@gmail.com") echo "aws_s3_01" ;;
        "fatec2017.sp@gmail.com") echo "aws_s3_02" ;;
        # Adicione novos usuários acima desta linha
        *) echo "" ;; # Retorna vazio se o e-mail não estiver na lista
    esac
}

obter_tokens_s3() {

    # Caminho do arquivo de configuração do rclone no seu Windows
    #RCLONE_CONF_PATH='C:\Users\manager\AppData\Roaming\rclone\rclone.conf'
    RCLONE_CONF_PATH='c:\RClone\rclone.conf'

    # Caminho do arquivo de credenciais da AWS no Learning Labs
    ARQUIVO="$HOME/.aws/credentials"

    echo "===================================================================="
    echo " Analisando ambiente e gerando script do rclone..."
    echo "===================================================================="
    echo ""

    # 1. Verifica se a variável de ambiente existe no terminal
    if [ -z "$VOC_EMAIL_ID" ]; then
        echo "Erro: A variável VOC_EMAIL_ID não está definida neste terminal."
        echo "Operação cancelada."
        return 1
    fi

    # 2. Busca qual é o disco mapeado para esse e-mail
    SELECTED_UPSTREAM=$(obter_upstream "$VOC_EMAIL_ID")

    # 3. Verifica se o e-mail possui um upstream configurado
    if [ -z "$SELECTED_UPSTREAM" ]; then
        echo "Erro: O usuário '$VOC_EMAIL_ID' não tem o upstream configurado no rclone."
        return 1
    fi

    echo "Usuário detectado: $VOC_EMAIL_ID"
    echo "Upstream selecionado: $SELECTED_UPSTREAM"
    echo "Extraindo tokens temporários..."
    echo ""

    # 4. Valida e extrai as credenciais
    if [ ! -f "$ARQUIVO" ]; then
        echo "Erro: Arquivo '$ARQUIVO' não encontrado."
        return 1
    fi

    AK=$(grep -E "^aws_access_key_id" "$ARQUIVO" | cut -d '=' -f 2- | tr -d ' ' | tr -d '\r')
    SK=$(grep -E "^aws_secret_access_key" "$ARQUIVO" | cut -d '=' -f 2- | tr -d ' ' | tr -d '\r')
    ST=$(grep -E "^aws_session_token" "$ARQUIVO" | cut -d '=' -f 2- | tr -d ' ' | tr -d '\r')

    if [ -z "$AK" ] || [ -z "$SK" ] || [ -z "$ST" ]; then
        echo "Erro: Não foi possível extrair todas as 3 chaves do arquivo."
        return 1
    fi

    # 5. Gera o comando PowerShell (aqui usamos o printf para blindar as barras invertidas)
    CMD="\$f='$RCLONE_CONF_PATH'; \$t=Get-Content \$f -Raw; \$t=\$t -replace '(?s)(\x5B$SELECTED_UPSTREAM\x5D(?:[^\x5B]*?)\baccess_key_id\s*=\s*)[^\r\n]*', '\${1}$AK' -replace '(?s)(\x5B$SELECTED_UPSTREAM\x5D(?:[^\x5B]*?)\bsecret_access_key\s*=\s*)[^\r\n]*', '\${1}$SK' -replace '(?s)(\x5B$SELECTED_UPSTREAM\x5D(?:[^\x5B]*?)\bsession_token\s*=\s*)[^\r\n]*', '\${1}$ST'; Set-Content \$f -Value \$t; Write-Host ''; Write-Host '>> Credenciais atualizadas com sucesso no rclone.conf para $SELECTED_UPSTREAM ($VOC_EMAIL_ID)' -ForegroundColor Green"

    echo "===================================================================="
    echo " Abra o PowerShell no seu Windows e COLOQUE o código abaixo:"
    echo "===================================================================="
    echo ""

    # Imprime o comando em PowerShell
    printf "%s\n" "$CMD"

    echo ""
}


# ==========================================
# FLUXO PRINCIPAL DO SCRIPT
# ==========================================

# Verificando se está no ambiente LL Vocareum
if [ -d "/home/vocuser" ]; then
    # Se o token NÃO for válido, tenta atualizar
    if ! valida_token; then
        printf "${VERMELHO}Token atual expirado ou inexistente. Tentando atualizar...${RESET}\n"
        
        # Se falhar na atualização, interrompe o fluxo (já que a msg de erro está na função)
        if ! atualiza_token; then
            return 1
        fi
    fi
    
    # Se chegou até aqui, o token está válido (ou já estava, ou acabou de ser atualizado)
    obter_tokens_s3

else
    # printf "${AZUL}Estamos no AWS Console${RESET}\n"
    if valida_token; then
        obter_tokens_s3 
    else
        printf "${VERMELHO}Erro: Sessão do AWS Console inválida ou expirada. Recarregue a página.${RESET}\n"
    fi
fi
