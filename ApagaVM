# CALL: . <(wget -qO- https://tinyurl.com/ApagaVM)

# ==========================================
# DEFINIÇÃO DE CORES (ANSI)
# ==========================================
VERDE="\033[0;32m"
AMARELO="\033[1;33m"
VERMELHO="\033[0;31m"
AZUL="\033[0;36m"
RESET="\033[0m"

# ==========================================
# BLOQUEIA A CHAMADA ANTIGA (| sh)
# ==========================================
if [ ! -t 0 ]; then
    printf "\n"
    printf "${VERMELHO}⚠️ ATENÇÃO: A forma de executar este laboratório mudou!${RESET}\n\n"
    printf "Para que as credenciais da AWS funcionem corretamente no seu terminal, "
    printf "você não pode mais usar o comando terminando em '| sh'.\n\n"
    printf "${AZUL}Por favor, copie e cole o comando EXATO abaixo e pressione [Enter]:${RESET}\n\n"
    printf "   ${VERDE}. <(wget -qO- https://tinyurl.com/removeVM)${RESET}\n\n"
    
    exit 1 
fi

# ==========================================
# FUNÇÕES DE VALIDAÇÃO E ATUALIZAÇÃO DA AWS
# ==========================================
valida_token() {
    if aws ec2 describe-instances --max-items 1 > /dev/null 2>&1; then
        return 0 # Sucesso
    else
        return 1 # Falha
    fi
}

atualiza_token() {
    if [ ! -z "$aws_access_key_id" ] && [ ! -z "$aws_secret_access_key" ] && [ ! -z "$aws_session_token" ]; then
        printf "${AZUL}Atualizando o Token da Sessão com as novas variáveis...${RESET}\n"
        
        mkdir -p ~/.aws
        chmod 664 ~/.aws/credentials
        echo "[default]" > ~/.aws/credentials
        echo "aws_access_key_id=$aws_access_key_id" >> ~/.aws/credentials
        echo "aws_secret_access_key=$aws_secret_access_key" >> ~/.aws/credentials
        echo "aws_session_token=$aws_session_token" >> ~/.aws/credentials
        
        if valida_token; then
            printf "${VERDE}✔ Token atualizado e validado com sucesso!${RESET}\n"
            return 0
        else
            printf "${VERMELHO}❌ Erro: As novas variáveis coladas parecem inválidas ou expiradas.${RESET}\n"
            return 1
        fi
    else
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "⚠️  ATENÇÃO: Credenciais da AWS não encontradas!\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        printf "Para resolver, siga estes passos simples:\n\n"
        printf "1. No topo da página do laboratório, clique no botão ${VERMELHO}[AWS Details]${RESET}.\n"
        printf "2. Copie as linhas das 3 variáveis de ambiente que vão aparecer.\n"
        printf "3. Cole-as diretamente aqui no Terminal e pressione ${VERMELHO}[Enter]${RESET}.\n"
        printf "4. Reexecute este script copiando e colando o comando abaixo:\n\n"
        printf "   ${VERDE}. <(wget -qO- https://tinyurl.com/removeVM)${RESET}\n\n"
        printf "${AMARELO}------------------------------------------------------------------------${RESET}\n"
        return 1
    fi
}

# ==========================================
# FUNÇÃO DE REMOÇÃO EC2
# ==========================================
remove_instancia() {
    echo "Buscando instâncias EC2 na sua conta AWS..."

    TMP_FILE=$(mktemp)
    MAP_FILE=$(mktemp)

    # Busca apenas instâncias que fazem sentido remover (ignora shutting-down e terminated)
    aws ec2 describe-instances \
        --filters "Name=instance-state-name,Values=pending,running,stopping,stopped" \
        --query "Reservations[*].Instances[*].[InstanceId, State.Name, Tags[?Key=='Name'].Value | [0]]" \
        --output text > "$TMP_FILE"

    if [ ! -s "$TMP_FILE" ]; then
        echo "Nenhuma instância apta para remoção foi encontrada."
        rm -f "$TMP_FILE" "$MAP_FILE"
        return 0
    fi

    echo ""
    echo "------------------------------------------------------------------"
    printf "%-5s | %-20s | %-12s | %-15s\n" "Item" "Instance ID" "Status" "Nome"
    echo "------------------------------------------------------------------"

    count=1
    while read -r id state name; do
        if [ -z "$name" ] || [ "$name" = "None" ]; then
            name="<Sem Nome>"
        fi
        
        printf "%-5s | %-20s | %-12s | %-15s\n" "[$count]" "$id" "$state" "$name"
        echo "$count $id $state" >> "$MAP_FILE"
        count=$((count+1))
    done < "$TMP_FILE"

    echo "------------------------------------------------------------------"
    echo ""

    echo "${VERMELHO}Aviso: A remoção (Terminate) apagará permanentemente a máquina e seus dados!${RESET}"
    echo "- Para remover instâncias específicas, digite os números (ex: 1 3)."
    echo "- Para apagar TODAS instâncias da lista de uma vez, digite: ${VERMELHO}remover_todas${RESET}"
    echo "(DICA: Se apenas apertar ENTER, nenhuma ação será tomada)"
    echo ""
    printf "Quais instâncias deseja REMOVER?: "
    read choices < /dev/tty

    TERMINATE_IDS=""

    # Lógica de decisão baseada no input do usuário
    if [ "$choices" = "remover_todas" ]; then
        # Extrai apenas a segunda coluna (os IDs) do arquivo de mapeamento
        TERMINATE_IDS=$(awk '{print $2}' "$MAP_FILE" | tr '\n' ' ')
    else
        while read -r num id state; do
            for choice in $choices; do
                if [ "$choice" = "$num" ]; then
                    TERMINATE_IDS="$TERMINATE_IDS $id"
                    break
                fi
            done
        done < "$MAP_FILE"
    fi

    rm -f "$TMP_FILE" "$MAP_FILE"
    echo ""

    if [ -n "$TERMINATE_IDS" ]; then
        echo "Iniciando o processo de remoção das instâncias selecionadas..."
        aws ec2 terminate-instances \
            --instance-ids $TERMINATE_IDS \
            --query "TerminatingInstances[*].{ID:InstanceId,Atual:CurrentState.Name,Anterior:PreviousState.Name}" \
            --output table
        echo ""
        echo "✔ Instâncias enviadas para remoção com sucesso!"
    else
        echo "Nenhuma instância foi selecionada. Operação cancelada."
    fi
}

# ==========================================
# FLUXO PRINCIPAL DO SCRIPT
# ==========================================
if [ -d "/home/vocuser" ]; then
    if ! valida_token; then
        printf "${VERMELHO}Token atual expirado ou inexistente. Tentando atualizar...${RESET}\n"
        if ! atualiza_token; then
            return 1
        fi
    fi
    remove_instancia
else
    if valida_token; then
        remove_instancia 
    else
        printf "${VERMELHO}Erro: Sessão do AWS Console inválida ou expirada. Recarregue a página.${RESET}\n"
    fi
fi