# CALL: wget -qO- https://tinyurl.com/exibeIP |sh

# O "if ! ..." verifica se o comando falhou (retornou um código diferente de zero)
if ! aws ec2 describe-instances --query "Reservations[*].Instances[*].{ \
        \"1_Name\":Tags[?Key=='Name']|[0].Value, \
        \"2_Tipo\":InstanceType, \
        \"3_Zone\":Placement.AvailabilityZone, \
        \"4_PublicIP\":PublicIpAddress}" \
    --filters "Name=instance-state-name,Values=running" \
    --output table 2>/dev/null; then

    # Bloco executado apenas se o comando AWS falhar
    printf "\n\033[31mERRO DE CREDENCIAIS:\033[0m Esse terminal não detectou corretamente a sua credencial de conexão com a AWS.\n"
    printf "Isso é comum ocorrer nessa tela inicial do ambiente Learning Labs da AWS com Vocareum.\n\n"
    printf "\033[1mCOMO RESOLVER:\033[0m\n"
    printf "1. Clique no botão 'AWS' (com a bolinha verde) para abrir o Console da AWS.\n"
    printf "2. No final da tela do Console, lado esquerdo, clique no ícone do \033[1m CloudShell\033[0m (ícone de terminal >_).\n"
    printf "3. Aguarde o ambiente carregar e cole o comando novamente:\n"
    printf "   \033[31mwget -qO- https://tinyurl.com/exibeIP | sh\033[0m\n\n"
    
    # Interrompe a execução do script para não exibir o restante das mensagens de forma desconexa
    exit 1
fi

