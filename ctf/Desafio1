    DocumentRoot /var/www/html_9090
    
    # Ativação do Motor SSL
    SSLEngine on
    SSLCertificateFile /etc/apache2/ssl/zeus.crt
    SSLCertificateKeyFile /etc/apache2/ssl/zeus.key

