# ==========================================
# 3. CONFIGURAÇÃO DO SERVIÇO FTP (Porta 21)
# ==========================================
# 1. Habilitar o login anônimo no arquivo de configuração principal
sed -i 's/anonymous_enable=NO/anonymous_enable=YES/g' /etc/vsftpd.conf

