chown RickSanchez:RickSanchez /home/RickSanchez/flag_60000.txt

# ---- RICK'S RESTRICTED SHELL (Apenas ls, pwd, cd, cat) ----
# Criamos um interpretador interativo em Python que filtra os comandos permitidos
cat << 'EOF' > /opt/ctf/restricted_shell.py
#!/usr/bin/env python3
import os
import sys
import subprocess

# Define o diretório inicial do aluno
os.chdir('/home/RickSanchez')

# Whitelist de comandos permitidos
ALLOWED_COMMANDS = ['ls', 'pwd', 'cd', 'cat']

def print_prompt():
    # Desenha um prompt customizado no estilo Rick and Morty
    current_dir = os.getcwd()
    sys.stdout.write(f"rick-shell:{current_dir}$ ")
    sys.stdout.flush()

sys.stdout.write("=== RICK'S SECURE TERMINAL v1.0 ===\n")
sys.stdout.flush()

while True:
    try:
        print_prompt()
        user_input = sys.stdin.readline()
        
        # Se a conexão for fechada (EOF), encerra o script
        if not user_input:
            break
            
        cmd_line = user_input.strip()
        if not cmd_line:
            continue
            
        # Divide a linha de comando em partes (comando e argumentos)
        parts = cmd_line.split()
        base_cmd = parts[0]
        
        # Validação contra a Whitelist
        if base_cmd not in ALLOWED_COMMANDS:
            sys.stdout.write(f"bash: {base_cmd}: command not found\n")
            sys.stdout.flush()
            continue
            
        # Comportamento interno especial para o comando 'cd' (já que ele muda o estado do processo)
        if base_cmd == 'cd':
            try:
                target_dir = parts[1] if len(parts) > 1 else '/home/RickSanchez'
                os.chdir(target_dir)
            except Exception as e:
                sys.stdout.write(f"cd: {str(e)}\n")
            continue
            
        # Executa de forma segura os outros comandos permitidos (ls, pwd, cat)
        # O shell=True é evitado por segurança, mas usamos subprocess para passar argumentos reais
        try:
            # Proteção básica contra encadeamento de comandos (ex: cat arquivo ; id)
            if ';' in cmd_line or '|' in cmd_line or '&' in cmd_line or '$' in cmd_line:
                sys.stdout.write("Error: Character not allowed in secure mode.\n")
                sys.stdout.flush()
                continue
                
            result = subprocess.run(parts, capture_output=True, text=True, timeout=5)
            sys.stdout.write(result.stdout)
            sys.stdout.write(result.stderr)
        except Exception as e:
            sys.stdout.write(f"Execution error: {str(e)}\n")
            
        sys.stdout.flush()
        
    except KeyboardInterrupt:
        sys.stdout.write("\nUse exit/logout to leave (or close connection).\n")
        sys.stdout.flush()
    except Exception:
        break
EOF

chmod +x /opt/ctf/restricted_shell.py

