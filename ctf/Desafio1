<VirtualHost *:9090>
    DocumentRoot /var/www/html_9090
    
    # Ativação do Motor SSL
    SSLEngine on
    SSLCertificateFile /etc/apache2/ssl/zeus.crt
    SSLCertificateKeyFile /etc/apache2/ssl/zeus.key

    # Opcional: Customização básica para parecer uma tela de login ou contexto do Zeus
    <Directory /var/www/html_9090>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
