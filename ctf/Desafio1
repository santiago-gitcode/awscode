# Gerar a Chave Privada e o Certificado Autoassinado silenciosamente via OpenSSL
openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/apache2/ssl/zeus.key \
    -out /etc/apache2/ssl/zeus.crt \
    -subj "/C=US/ST=Earth/L=C-137/O=ZeusAdmin/OU=FakeLogin/CN=zeus-admin.local"

# Criar o VirtualHost dedicado na porta 9090 forçando o uso de SSL
